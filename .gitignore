# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
._*

# Large binary ML/model files
*.h5
*.hdf5
*.pth
*.npy
*.nc
*.nc4
# STREAM-Sat CSGD domain params are small and required at runtime
!tito_utils/qpe_utils/STREAM-Sat-realtime/*.csgdNLWAR_DPR.nc
*.grb
*.grib
*.grib2
*.pkl

# Temporary files
*.tmp
*.log
temp/
logs/
tito_utils/qpe_utils/STREAM-Sat-realtime/tmp*/

# Raster/binary data files — never commit these (except basic/ and parameters/)
*.tif
*.tiff
*.aux.xml
!EF5_conf/basic/**/*.tif
!EF5_conf/basic/**/*.tiff
!EF5_conf/parameters/**/*.tif
!EF5_conf/parameters/**/*.tiff
!EF5_conf/pet/**/*.tif
!EF5_conf/pet/**/*.tiff

# ── Runtime data dirs: keep folder shells via .gitkeep, ignore contents ──
EF5_conf/precip/**
!EF5_conf/precip/.gitkeep
EF5_conf/precipEF5/**
!EF5_conf/precipEF5/.gitkeep
EF5_conf/qpf_store/**
!EF5_conf/qpf_store/.gitkeep
EF5_conf/states/**
!EF5_conf/states/.gitkeep
outputs/**
!outputs/.gitkeep

# Docker image archives / partner bundle → host on Zenodo (not GitHub)
dist/
*.tar.gz

# Container images (large) — build locally or download from Zenodo
tito.sif
EF5/*.sif
EF5/*.tar

# Nested upstream repo (StormLab under tito_utils/qpf_utils/)
tito_utils/qpf_utils/StormLab-GFS-realtime/WMO.zip
tito_utils/qpf_utils/StormLab-GFS-realtime/output/
tito_utils/qpf_utils/StormLab-GFS-realtime/*/__pycache__/
tito_utils/qpf_utils/StormLab-GFS-realtime/__pycache__/
!tito_utils/qpf_utils/StormLab-GFS-realtime/params/**

# STREAM-Sat runtime caches (regenerated each cycle)
tito_utils/qpe_utils/STREAM-Sat-realtime/extension/realtime/state/
tito_utils/qpe_utils/STREAM-Sat-realtime/extension/realtime/output/

# Local scratch / training dumps
trainings/
